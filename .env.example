# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# --- Grounded Reasoning ---
# When enabled, follow-up questions and chat synthesis are answered by an LLM
# reasoning over raw USGS evidence (not pre-computed templates).
# Provider fallback: Anthropic > OpenAI > Gemini > Qwen > Ollama
GROUNDWATERGPT_ENABLE_GROUNDED_REASONING=true
VITE_ENABLE_LLM_INTERPRETATION=true

# --- Default LLM Provider ---
# Used for general LLM tasks. Grounded reasoning uses its own provider chain
# (see above) and tries each available provider automatically.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:32b

# Override the reasoning model (optional — defaults to LLM_MODEL or provider default)
# GROUNDWATERGPT_REASONING_MODEL=qwen3:32b

# --- API Keys ---
# Set any/all of these. The grounded reasoning chain tries each available
# provider in order: Anthropic (best) > OpenAI > Gemini (free) > Qwen > Ollama (local).

# Anthropic Claude (recommended for quality)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini (free tier available)
# GOOGLE_API_KEY=AIza...

# Qwen via Alibaba DashScope
# DASHSCOPE_API_KEY=sk-...

# Ollama runs locally with no API key — install ollama and pull a model:
#   ollama pull qwen3:8b      (5GB, fast)
#   ollama pull qwen3:32b     (20GB, better quality)
