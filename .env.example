# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# --- Grounded Reasoning ---
# When enabled, follow-up questions and chat synthesis are answered by Qwen
# reasoning over raw USGS evidence (not pre-computed templates).
GROUNDWATERGPT_ENABLE_GROUNDED_REASONING=true
VITE_ENABLE_LLM_INTERPRETATION=true

# --- LLM Provider (Qwen only) ---
# Two backends, both serve Qwen:
#   ollama — local Qwen via the Ollama runtime (no API key)
#   qwen   — hosted Qwen via Alibaba DashScope (requires DASHSCOPE_API_KEY)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:32b

# Override the reasoning model (optional — defaults to LLM_MODEL or provider default)
# GROUNDWATERGPT_REASONING_MODEL=qwen3:32b

# --- Qwen via Alibaba DashScope (only needed when LLM_PROVIDER=qwen) ---
# DASHSCOPE_API_KEY=sk-...

# Ollama runs locally with no API key — install ollama and pull a model:
#   ollama pull qwen3:8b      (5GB, fast)
#   ollama pull qwen3:32b     (20GB, better quality)
