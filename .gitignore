.claude/

# Session-scoped agent memory and plugin caches (not project source)
.remember/
docs/superpowers/

# UAT ledgers are debugging history, not committed source
tests/edge_cases/uat_ledger/

# Jupyter
.ipynb_checkpoints/

# Coverage reports
.coverage
htmlcov/

# Environment
.env

# Outputs (regenerate as needed)
outputs/
*.log

