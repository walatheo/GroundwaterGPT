# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# --- LLM Provider ---
# Options: anthropic | openai | ollama | gemini | qwen
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus

# --- API Keys (set whichever matches LLM_PROVIDER) ---

# Qwen via Alibaba DashScope (https://dashscope.aliyuncs.com)
# Models: qwen-turbo (fast/cheap) | qwen-plus (balanced) | qwen-max (most capable)
#         qwen2.5-72b-instruct (open-weight hosted)
DASHSCOPE_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GOOGLE_API_KEY=...

# Ollama (local, no API key needed — install ollama + pull model)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
