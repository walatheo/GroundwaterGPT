# GroundwaterGPT Environment Variables (Qwen only).
# Copy this file to .env and fill in values if needed.

# --- LLM Provider ---
#   ollama — local Qwen via the Ollama runtime (no API key)
#   qwen   — hosted Qwen via Alibaba DashScope (requires DASHSCOPE_API_KEY)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b

# Qwen via Alibaba DashScope (only when LLM_PROVIDER=qwen)
# DASHSCOPE_API_KEY=sk-...
